# Caddy sets X-Forwarded-For to the address of the connecting client and drops any
# value the client sent (unless `trusted_proxies` is configured here, which it is not).
# The server takes the client address from that header for its per-IP limits
# (REVIT_DOWNGRADE_TRUST_PROXY=true in docker-compose.yml).
{$REVIT_DOWNGRADE_DOMAIN:localhost} {
	encode gzip

	# Uploads are resumable (tus) and sent in chunks of at most 50 MiB, but allow the
	# full 1 GiB file plus overhead in case a client sends it in one request.
	request_body {
		max_size 1100MB
	}

	reverse_proxy server:8080 {
		# Upstream timeouts: allow slow responses from the server without cutting the connection.
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
